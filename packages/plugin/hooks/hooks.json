{
  "description": "YandeCode lifecycle hooks: session tracking and incremental index dirty-marking",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "yandecode hook SessionStart", "timeout": 10 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "yandecode hook PostToolUse", "timeout": 10 }]
      }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "yandecode hook SessionEnd", "timeout": 10 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "yandecode hook SubagentStop", "timeout": 10 }] }
    ],
    "WorktreeCreate": [
      {
        "hooks": [{ "type": "command", "command": "yandecode hook WorktreeCreate", "timeout": 10 }]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [{ "type": "command", "command": "yandecode hook WorktreeRemove", "timeout": 10 }]
      }
    ]
  }
}
